# R session files
.Rhistory
.RData
.Rproj.user/
*.Rproj
.Rapp.history

# Synthetic data is regenerated by R/00_simulate_cohort.R (seeded, ~1 s).
# Nothing in data/ is committed, so nothing in data/ can be mistaken for real data.
data/synthetic/*.csv
data/synthetic/*.sqlite
data/synthetic/*.sqlite-journal

# Large or fully derived outputs; the small summary tables in output/ are committed.
output/feature_matrix.csv
output/test_predictions.csv
output/bootstrap_optimism.csv
output/*.rds

# OS
.DS_Store
